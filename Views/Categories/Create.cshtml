
@model YouthHub.Models.Category

@{
    ViewData["Title"] = "Добави категория";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <h1 class="display-6 fw-bold mb-4">Добави категория</h1>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">
                        Име на категорията
                    </label>
                    <input asp-for="Name" class="form-control"
                           placeholder="Напр. Доброволчество" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Описание
                    </label>
                    <textarea asp-for="Description" class="form-control"
                              rows="3"
                              placeholder="Кратко описание на категорията"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">
                    Запази категорията
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary ms-2">
                    Назад
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
