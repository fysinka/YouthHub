
@model YouthHub.Models.Application

@{
    ViewData["Title"] = "Кандидатствай";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <h1 class="display-6 fw-bold">Кандидатствай за участие</h1>

            <p class="lead">
                Инициатива: <strong>@ViewBag.InitiativeTitle</strong>
            </p>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <input type="hidden" asp-for="InitiativeId" />

                <div class="mb-3">
                    <label asp-for="ApplicantName" class="form-label">
                        Твоето име
                    </label>
                    <input asp-for="ApplicantName"
                           class="form-control"
                           placeholder="Въведи име и фамилия" />
                    <span asp-validation-for="ApplicantName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">
                        Имейл адрес
                    </label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="name@example.com" />
                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">
                    Изпрати кандидатурата
                </button>

                <a asp-controller="Initiatives"
                   asp-action="Index"
                   class="btn btn-outline-secondary ms-2">
                    Назад
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
